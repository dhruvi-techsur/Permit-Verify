# ─── App ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://permit_user:permit_pass@localhost:5432/permit_db

# ─── JWT ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-in-prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod
JWT_REFRESH_EXPIRES_IN=7d

# ─── S3 Storage ──────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=permit-documents
S3_ENDPOINT=http://localhost:9000

# ─── Email ───────────────────────────────────────────────
SMTP_FROM=noreply@permitflow.test
RESEND_API_KEY=your-resend-api-key-here

# ─── Rate Limiting ───────────────────────────────────────
THROTTLE_AUTH_LIMIT=5
THROTTLE_AUTH_TTL=60000

# ─── Frontend (Vite env vars) ────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_MAX_FILE_SIZE_MB=25
